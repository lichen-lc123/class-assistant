# Replace study.example.com and the certificate paths before using.
# The Node process must remain bound to 127.0.0.1:3001.
server {
    listen 80;
    server_name study.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name study.example.com;

    ssl_certificate /etc/ssl/homework/fullchain.pem;
    ssl_certificate_key /etc/ssl/homework/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 40m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
    }
}
