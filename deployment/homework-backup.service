[Unit]
Description=Class assistant consistent SQLite backup
After=homework.service

[Service]
Type=oneshot
User=homework
Group=homework
WorkingDirectory=/opt/homework/current
EnvironmentFile=/etc/homework/homework.env
ExecStart=/opt/class-assistant-runtime/node-v24.22.2-linux-x64/bin/node scripts/backup-database.mjs /var/lib/homework/backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homework
