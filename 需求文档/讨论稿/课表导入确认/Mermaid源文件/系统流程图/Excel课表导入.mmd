%% Excel课表导入 · 系统流程图 · V0.5 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜提交学年、目标学期与文件<br/>source_type=excel"]
    N2{"后端｜该用户本学期允许<br/>使用当前来源？"}
    B2["已有其他来源时拒绝<br/>提示先删除原课表"]
    N3["后端｜读取 XLS / XLSX 表格<br/>普通规则解析，不调用 AI"]
    N4{"后端｜文件可读取且<br/>属于所选学年及学期？"}
    B4["提示损坏或格式错误<br/>跨学期数据须分别导入"]
    N5["后端｜提取课程、学季及来源<br/>保留原文，标记缺失和疑似重复"]
    N6[("数据库｜读取上课班、教学日历<br/>及节次作息配置")]
    N7["后端｜按已确认规则展开日期<br/>处理补课、调课与实践活动"]
    N8["前端｜预览合并结果<br/>确认去重、班号和个人安排"]
    N9[("数据库｜重新校验来源与唯一性<br/>保存个人学期课表和待安排项")]
    N10(["结束"])
    N0 --> N1
    N1 -->|学期与多个文件| N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 -->|课程候选与缺失清单| N6
    N6 -->|班级匹配、周次及作息| N7
    N7 -->|排课预览、重复与冲突| N8
    N8 -->|确认后的课程关系与安排| N9
    N9 --> N10
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 normal;
    class N6 database;
    class N7 normal;
    class N8 normal;
    class N9 database;
    class N10 terminal;
