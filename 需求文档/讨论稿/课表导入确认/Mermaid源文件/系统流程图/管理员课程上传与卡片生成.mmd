%% 管理员课程上传与卡片生成 · 系统流程图 · V0.5 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员前端｜展示课程上传表单<br/>自动生成课程卡片默认 true"]
    N2["前端｜提交学年、学期、课程资料<br/>及 generate_cards 选择"]
    N3{"后端｜当前身份为管理员？"}
    B3["拒绝普通用户上传公共课程<br/>或请求生成公共卡片"]
    N4["后端｜校验课程、上课班与归属<br/>保留待安排状态并检查重复"]
    N5{"后端｜资料有效且<br/>管理员确认保存？"}
    B5["返回具体问题<br/>不写入课程或卡片"]
    N6{"后端｜要求自动生成卡片？"}
    B6["数据库｜仅保存课程<br/>未生成卡片的新课程不进卡片库"]
    N7[("数据库｜事务保存课程与上课班<br/>生成对应卡片，已有卡片不重复建")]
    N8["后端｜返回上传与卡片生成数量<br/>仅发布的卡片对学生可见"]
    N9["学生前端｜请求课程卡片搜索<br/>后端仅返回管理员发布的卡片"]
    N10(["结束"])
    N0 --> N1
    N1 -->|课程资料及默认勾选项| N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 -->|课程、班级与校验结果| N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 -->|否| B6
    N6 -->|是| N7
    N7 -->|保存及卡片生成结果| N8
    N8 -->|管理员发布的可用卡片| N9
    N9 --> N10
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 decision;
    class B6 exception;
    class N7 database;
    class N8 normal;
    class N9 normal;
    class N10 terminal;
