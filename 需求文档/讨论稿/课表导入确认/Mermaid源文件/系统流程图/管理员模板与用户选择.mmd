%% 管理员模板与用户选择 · 系统流程图 · V0.5 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员前端｜提交学期、公共课程<br/>上课班与模板内容"]
    N2["后端｜校验管理员角色<br/>检查上课班身份和数据完整性"]
    N3[("数据库｜保存公共课程、上课班<br/>学期模板与模板成员关系")]
    N4["学生前端｜提交学期及模板 ID<br/>source_type=template"]
    N5{"后端｜该用户本学期允许<br/>使用当前来源？"}
    B5["已有其他来源时拒绝<br/>提示先删除原课表"]
    N6["后端｜读取已发布模板<br/>检查模板与所选学期一致"]
    N7["前端｜展示模板内容<br/>由学生确认使用"]
    N8[("数据库｜保存本次所选班级关系<br/>记录模板 ID、版本及来源")]
    N9["后端｜读取公共上课安排<br/>按个人覆盖生成显示结果"]
    N10(["结束"])
    N0 --> N1
    N1 -->|管理员提供的公共资料| N2
    N2 --> N3
    N3 -->|已发布的学期模板| N4
    N4 --> N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 -->|模板课程和上课班信息| N7
    N7 -->|学生确认的模板成员| N8
    N8 -->|个人选课关系与公共安排| N9
    N9 --> N10
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 database;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 normal;
    class N7 normal;
    class N8 database;
    class N9 normal;
    class N10 terminal;
