%% 课程卡片自由组合 · 业务流程图 · V0.5 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员｜上传课程<br/>默认勾选自动生成卡片并发布"]
    N2["学生｜选择学期及自由组合入口"]
    N3{"系统｜没有其他来源的<br/>本学期课表？"}
    B3["提示先删除原课表再换来源"]
    N4["学生｜搜索课程名、老师、课程编号<br/>或上课班编号，按学季筛选"]
    N5["学生｜拖入我的课程<br/>手机点击加入或移除"]
    N6["系统｜提示重复、具体日期冲突<br/>以及时间待通知的课程"]
    N7{"学生｜确认当前组合<br/>并接受保留的冲突？"}
    B7["调整选择后重新检查"]
    N8["系统｜保存一份学期课表<br/>公共课程不受个人移除影响"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    N7 -->|否| B7
    N7 -->|是| N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 decision;
    class B7 exception;
    class N8 normal;
    class N9 terminal;
