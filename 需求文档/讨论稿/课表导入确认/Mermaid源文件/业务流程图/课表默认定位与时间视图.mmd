%% 课表默认定位与时间视图 · 业务流程图 · V0.5 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["学生｜进入我的课表"]
    N2["系统｜按课程时区的今天<br/>查找当前学期"]
    N3{"系统｜能确定唯一当前学期？"}
    B3["无进行中学期则提示选择<br/>多个学期匹配则由学生确认"]
    N4{"系统｜本人已有本学期课表？"}
    B4["提示先建立当前学期课表<br/>不自动展示旧学期代替"]
    N5["系统｜默认显示今天的课<br/>突出正在上课和下一节"]
    N6["学生｜切换学期、月、周、日视图<br/>各自定位当前时间范围"]
    N7["系统｜显示对应范围内课程<br/>没有课时明确提示"]
    N8["学生｜可浏览其他时期<br/>点击回到今天恢复默认定位"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 decision;
    class B4 exception;
    class N5 normal;
    class N6 normal;
    class N7 normal;
    class N8 normal;
    class N9 terminal;
