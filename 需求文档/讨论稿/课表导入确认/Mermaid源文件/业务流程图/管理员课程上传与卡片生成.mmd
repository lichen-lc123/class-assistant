%% 管理员课程上传与卡片生成 · 业务流程图 · V0.5 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员｜选择学年与学期<br/>上传公共课程及上课班资料"]
    N2["网站｜自动生成课程卡片<br/>选项默认勾选，可取消"]
    N3["管理员｜预览课程和上课班<br/>核对资料并确认上传"]
    N4{"系统｜课程资料校验通过？"}
    B4["提示修正资料<br/>不写入课程或生成卡片"]
    N5{"管理员｜保留自动生成<br/>课程卡片的勾选？"}
    B5["仅保存已确认课程<br/>新课程不出现在卡片搜索中"]
    N6["系统｜保存课程及上课班<br/>自动生成对应卡片"]
    N7["管理员｜确认发布课程卡片"]
    N8["学生｜搜索、预览并加入卡片<br/>仅改变本人课表，不上传公共卡片"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 --> N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 decision;
    class B5 exception;
    class N6 normal;
    class N7 normal;
    class N8 normal;
    class N9 terminal;
