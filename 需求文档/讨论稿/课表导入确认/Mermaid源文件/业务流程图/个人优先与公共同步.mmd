%% 个人优先与公共同步 · 业务流程图 · V0.5 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员｜更新公共上课班安排"]
    N2["系统｜找出已选择该班的个人课表"]
    N3{"系统｜相应字段<br/>是否有个人修改？"}
    B3["同步公共新值<br/>并提示公共安排已更新"]
    N4["系统｜保留该字段个人值<br/>提示公共新值与个人值的差异"]
    N5["学生｜查看差异和冲突"]
    N6{"学生｜保留个人值？"}
    B6["清除该字段个人覆盖<br/>跟随最新公共值"]
    N7["系统｜继续使用个人值<br/>不影响其他用户"]
    N8(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 -->|否| B6
    N6 -->|是| N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 normal;
    class N6 decision;
    class B6 exception;
    class N7 normal;
    class N8 terminal;
