%% 批量导入账号 · 业务流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员进入批量导入"]
    N2["上传名单或粘贴 Excel 两列<br/>设置统一初始密码"]
    N3{"名单格式与条数符合要求？"}
    B3["提示修正后重新导入"]
    N4["逐条检查字段与重复学号"]
    N5["创建有效新账号<br/>跳过重复与无效行"]
    N6["查看成功、跳过和错误明细"]
    N7["告知学生初始密码<br/>学生首次登录改密"]
    N8(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 normal;
    class N8 terminal;
