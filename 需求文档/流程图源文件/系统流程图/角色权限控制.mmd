%% 角色权限控制 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["前端｜根据角色及设备渲染入口"]
    N2["后端｜每次受保护请求读取当前会话和角色"]
    N3{"后端｜管理请求来自有效管理员？"}
    B3["后端｜拒绝未登录、学生<br/>或尚未完成首次改密的请求"]
    N4["后端｜公共管理不增加创建者筛选<br/>私人记录继续校验 owner_id"]
    N5[("数据库｜保留 created_by 作为记录归属<br/>不将其用作公共内容的管理权限")]
    N6(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 database;
    class N6 terminal;
