%% 管理员初始化 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["本机工具｜运行 init-admin<br/>不回显读取初始化信息"]
    N2[("数据库｜检查是否已有 admin")]
    N3{"数据库｜尚无管理员？"}
    B3["拒绝重复初始化"]
    N4["本机工具｜校验必填与密码长度<br/>生成独立盐及密码哈希"]
    N5[("数据库｜插入首位管理员<br/>role=admin，改密标记=0")]
    N6["本机工具｜仅报告成功<br/>不输出密码"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 database;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 database;
    class N6 normal;
    class N7 terminal;
