%% 修改密码 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜检查两次新密码一致"]
    N2{"后端｜会话、新密码规则<br/>及当前密码均有效？"}
    B2["返回校验失败或登录失效"]
    N3["后端｜生成独立盐与 scrypt 哈希"]
    N4{"后端｜会话及原密码<br/>在计算期间未变化？"}
    B4["拒绝修改，要求重新登录"]
    N5[("数据库｜更新密码哈希<br/>清除首次改密标记、更新修改时间")]
    N6[("数据库｜撤销该账号旧会话<br/>创建当前设备新会话")]
    N7["后端｜更新 Cookie 并返回账号"]
    N8["前端｜清空密码输入并提示成功"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 database;
    class N6 database;
    class N7 normal;
    class N8 normal;
    class N9 terminal;
