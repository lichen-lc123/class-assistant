%% 批量导入账号 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜读取文件或粘贴文本<br/>提交 text 与初始密码"]
    N2{"后端｜管理权限、密码<br/>及名单整体有效？"}
    B2["拒绝整批，提示修正"]
    N3["后端｜解析字段并逐行校验<br/>记录无效行和重复项"]
    N4["后端｜为新账号逐个生成哈希<br/>写入前再次验证管理会话"]
    N5[("数据库｜事务中 INSERT OR IGNORE<br/>角色 student，改密标记 1")]
    N6{"数据库｜事务执行成功？"}
    B6["回滚本批写入并返回失败"]
    N7["后端｜返回成功、重复及无效明细"]
    N8["前端｜显示结果并刷新账号列表"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 -->|否| B6
    N6 -->|是| N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 normal;
    class N4 normal;
    class N5 database;
    class N6 decision;
    class B6 exception;
    class N7 normal;
    class N8 normal;
    class N9 terminal;
