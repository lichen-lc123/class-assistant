%% 删除账号 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜显示不可撤销确认弹窗"]
    N2["前端｜确认后发送 DELETE"]
    N3{"后端｜管理权限、目标存在<br/>且非本人、非最后管理员？"}
    B3["拒绝删除并返回原因"]
    N4[("数据库｜删除 users 记录")]
    N5[("数据库｜外键级联删除<br/>目标账号所有 sessions")]
    N6["后端｜返回成功<br/>前端刷新列表"]
    N7["后续认证｜目标账号与旧会话<br/>均无法通过验证"]
    N8(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 database;
    class N5 database;
    class N6 normal;
    class N7 normal;
    class N8 terminal;
