%% 个人作业新增与维护 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["用户｜点击新增个人作业"]
    N2{"网站｜该学期已有本人课程？"}
    B2["用户｜先导入本学期课程"]
    N3["用户｜选择课程，自动带出老师"]
    N4["用户｜填写正文、截止及图片附件"]
    N5["网站｜保存为仅本人可见<br/>与课程作业一起展示"]
    N6["用户｜后续编辑、完成或确认删除"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 normal;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
