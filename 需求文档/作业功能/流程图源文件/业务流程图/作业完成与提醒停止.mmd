%% 作业完成与提醒停止 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["用户｜查看本人待完成作业"]
    N2["用户｜点击完成或详情内切换状态"]
    N3["网站｜核对当前版本并保存本人选择"]
    N4["网站｜完成后移出工作台并减少数量"]
    N5["用户｜在已完成列表倒序查看<br/>可恢复未完成"]
    N6["网站｜恢复后重新参与待做排序"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
