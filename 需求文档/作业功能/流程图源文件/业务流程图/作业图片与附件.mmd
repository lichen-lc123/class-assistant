%% 作业图片与附件 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["维护者｜添加文件或导入带附件的作业表"]
    N2["网站｜识别实际文件<br/>保留正文或考核等字段归属"]
    N3{"网站｜文件和归属可以可靠识别？"}
    B3["维护者｜按提示补充文件或核对归属"]
    N4["维护者｜在预览核对附件名称并保存"]
    N5["同学｜点击附件站内预览<br/>也可下载或保存／分享"]
    N6["网站｜旧记录继续使用原文件<br/>没有保存过的文件需补传"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
