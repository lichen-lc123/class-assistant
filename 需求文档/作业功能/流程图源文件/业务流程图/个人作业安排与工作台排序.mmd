%% 个人作业安排与工作台排序 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["用户｜按课程或老师筛选本人作业"]
    N2["用户｜可设置优先级及计划完成时间"]
    N3["网站｜保留独立的公共截止时间<br/>按个人有效时间排序"]
    N4["用户｜工作台查看待做卡片及倒计时<br/>电脑 4 项、手机 2 项"]
    N5["用户｜点击卡片查看或点击完成"]
    N6["网站｜刷新数量、更新标记和候选补位<br/>已完成按完成时间倒序"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
