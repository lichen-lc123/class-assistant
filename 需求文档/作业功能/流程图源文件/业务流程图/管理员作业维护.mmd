%% 管理员作业维护 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["管理员｜选择学期并查看所有公共作业"]
    N2["管理员｜新增或编辑内容<br/>可多选适用课程，截止可不填"]
    N3["网站｜保存编辑<br/>待确认内容始终保留草稿"]
    N4{"管理员｜需要发布草稿？"}
    B4["网站｜保留草稿及原因<br/>已发布记录保存后保持发布"]
    N5{"网站｜课程、内容确认及版本有效？"}
    B5["管理员｜补充核对或刷新后重试"]
    N6["管理员｜点击独立的发布按钮"]
    N7["网站｜对应课程同学可见<br/>可设置全部完成或全部未完成"]
    N8(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 --> N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 decision;
    class B5 exception;
    class N6 normal;
    class N7 normal;
    class N8 terminal;
