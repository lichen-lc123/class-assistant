%% Excel作业导入 · 业务流程图 · V1.0 · 2026-11-04
flowchart TD
    N0(["开始"])
    N1["学委｜进入作业管理并选择学期<br/>选择本地作业表 Excel"]
    N2["网站｜识别多工作表、作业<br/>考核说明及相关图片"]
    N3{"网站｜表头和文件<br/>可识别？"}
    B3["学委｜查看错误原因<br/>修正或另存 XLSX 后重试"]
    N4["网站｜展示导入预览<br/>保留原截止说明和警告"]
    N5["学委｜逐项核对作业与图片<br/>选择上课班或保留草稿"]
    N6["学委｜勾选确认并导入<br/>可排除本次不需要的记录"]
    N7["网站｜保存所选记录<br/>重复跳过，不覆盖已有内容"]
    N8["学委｜查看新增与草稿结果<br/>后续可编辑并发布草稿"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 normal;
    class N8 normal;
    class N9 terminal;
