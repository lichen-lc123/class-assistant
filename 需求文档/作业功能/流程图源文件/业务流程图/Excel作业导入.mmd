%% Excel作业导入 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["管理员｜选择学期及 XLSX 作业表"]
    N2["网站｜解析内容、图片、文件和链接<br/>“无”不生成作业"]
    N3["网站｜无上课时间则匹配同名同老师全部课<br/>有明确时间则按时间核对"]
    N4{"网站｜范围及内容可可靠确定？"}
    B4["网站｜保留原文为待确认草稿<br/>缺课程可等待补齐后重查"]
    N5["管理员｜核对并确认导入<br/>无截止时间不阻止发布"]
    N6["网站｜同课程、老师、作业次数<br/>更新原内容并保留个人状态"]
    N7["网站｜反馈新增、更新及草稿数量"]
    N8(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    B4 --> N5
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 normal;
    class N6 normal;
    class N7 normal;
    class N8 terminal;
