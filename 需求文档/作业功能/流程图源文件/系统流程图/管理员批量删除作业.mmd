%% 管理员批量删除作业 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["前端｜提交 termId、confirm<br/>及各记录的 id、revision"]
    N2{"后端｜管理员且所有记录均属当前学期？"}
    B2["后端｜拒绝越权、重复或无效选择"]
    N3{"后端｜所有版本均匹配？"}
    B3["后端｜整批拒绝并提示刷新"]
    N4[("数据库｜同一事务删除所选公共记录<br/>级联清理完成、偏好和附件关联")]
    N5["前端｜清空选择并更新清单"]
    N6(["结束"])
    N0 --> N1
    N1 --> N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 decision;
    class B3 exception;
    class N4 database;
    class N5 normal;
    class N6 terminal;
