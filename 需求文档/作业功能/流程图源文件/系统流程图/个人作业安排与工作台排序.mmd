%% 个人作业安排与工作台排序 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["后端｜从本人选课筛选已发布作业<br/>合并仅本人可见的私人记录"]
    N2[("数据库｜读取正文、附件、本人偏好<br/>已读版本及完成策略")]
    N3["后端｜合成截止、个人计划及完成状态"]
    N4["后端｜过滤实际未完成作业并排序<br/>摘要返回前 4 项"]
    N5["前端｜电脑取 4 项、手机取 2 项<br/>菜单和标签显示对应数量"]
    N6["前端｜查看确认或完成后刷新摘要<br/>只修改本人的偏好或已读状态"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 database;
    class N3 normal;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
