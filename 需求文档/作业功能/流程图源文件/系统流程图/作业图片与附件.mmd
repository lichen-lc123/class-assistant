%% 作业图片与附件 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["后端｜解包 XLSX 并读取图片及 OLE 数据"]
    N2["后端｜按流名称和文件签名提取内容<br/>去除兼容重复引用并判断锚点"]
    N3{"后端｜类型、大小及字段有效？"}
    B3["后端｜提示无法提取或拒绝不合规文件"]
    N4[("数据库｜保存摘要、原始字节<br/>及作业到字段的附件关联")]
    N5["后端｜兼容读取历史附件记录<br/>生成授权文件地址"]
    N6{"后端｜访问者有权查看此条作业？"}
    B6["后端｜拒绝附件访问"]
    N7["前端｜PDF 本地画布翻页<br/>DOCX/PPTX 请求授权内容预览<br/>其他文件下载或原生分享"]
    N8(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 -->|否| B6
    N6 -->|是| N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 database;
    class N5 normal;
    class N6 decision;
    class B6 exception;
    class N7 normal;
    class N8 terminal;
