%% 作业完成与提醒停止 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["前端｜提交 completed 和 revision"]
    N2{"后端｜本人可见且版本匹配？"}
    B2["后端｜拒绝越权或旧版本"]
    N3["后端｜读取全员策略与本人当前代次例外"]
    N4[("数据库｜保存本人完成版本<br/>或当前代次的未完成例外")]
    N5["后端｜合成 completed、completedAt<br/>及未完成数量"]
    N6["前端｜移除已完成待做卡片并补位<br/>已完成按完成时间倒序"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 normal;
    class N4 database;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
