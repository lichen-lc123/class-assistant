%% 个人作业新增与维护 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["前端｜提交本人选课 ID 及作业字段"]
    N2{"后端｜选课确属本人和目标学期？"}
    B2["后端｜拒绝任意课程或他人选课"]
    N3["后端｜从课表读取课程名称和老师<br/>忽略伪造的显示值"]
    N4[("数据库｜保存 owner_id 及附件关联<br/>不建立公共发布关系")]
    N5["后端｜后续访问核对 owner_id 和版本"]
    N6["前端｜并入本人作业列表及待做摘要"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 normal;
    class N4 database;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
