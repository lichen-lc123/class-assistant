%% 管理员作业维护 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["前端｜携带会话读取管理清单<br/>不按 created_by 筛选"]
    N2{"后端｜管理员且完成首次改密？"}
    B2["后端｜返回 401 或 403"]
    N3["前端｜提交多个课程目标<br/>人工编辑不隐式发布"]
    N4[("数据库｜事务更新字段、附件及版本<br/>保留个人计划和全员状态策略")]
    N5["前端｜独立提交 publish 与 revision"]
    N6{"后端｜目标有效且待确认内容已核对？"}
    B6["后端｜保留草稿，不强制填写截止"]
    N7[("数据库｜发布记录及多课程关联")]
    N8["后端｜普通用户按已选课程读取<br/>无截止时返回空日期而非虚构时间"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 -->|否| B6
    N6 -->|是| N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 normal;
    class N4 database;
    class N5 normal;
    class N6 decision;
    class B6 exception;
    class N7 database;
    class N8 normal;
    class N9 terminal;
