%% Excel作业导入 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["后端｜验证管理员、学期和 XLSX 结构"]
    N2["后端｜读取工作表、图片与 OLE 文件<br/>同一 Choice/Fallback 对象只解析一次"]
    N3["后端｜匹配课程候选及已有作业身份"]
    N4["前端｜展示附件名、字段归属和冲突警告"]
    N5{"后端｜确认、版本及附件引用有效？"}
    B5["后端｜拒绝导入并保持原内容"]
    N6[("数据库｜按原记录 ID 更新内容<br/>新作业创建新记录及附件关联")]
    N7[("数据库｜同步完成版本且保留偏好<br/>已有发布状态及全员策略保留")]
    N8["后端｜返回导入统计并刷新列表"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 --> N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 database;
    class N7 database;
    class N8 normal;
    class N9 terminal;
