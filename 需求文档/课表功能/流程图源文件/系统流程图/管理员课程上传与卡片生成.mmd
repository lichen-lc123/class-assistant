%% 管理员课程上传与卡片生成 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜提交目标学期、模板名<br/>及Excel、外部AI或手动课程"]
    N2["后端｜验证管理员及目标学期<br/>解析课表并规范化课程"]
    N3["后端｜匹配同班及可证明相同的无班号课程<br/>返回现有卡片实际安排和摘要"]
    N4["前端｜核对新增、复用与差异<br/>提交确认及catalogVersion"]
    N5{"后端｜字段、模板名称<br/>及课程库摘要仍有效？"}
    B5["前端｜修正错误或重新预览<br/>不留下半份模板或课程"]
    N6[("数据库｜事务保存模板及成员关系<br/>新课程生成卡片，已存在课程复用")]
    N7["前端｜显示新增与复用数量<br/>可继续导入另一位同学的模板"]
    N8(["结束"])
    N0 --> N1
    N1 -->|学期、模板名和一位同学课表| N2
    N2 -->|解析出的课程和上课班| N3
    N3 -->|去重候选及已有卡片实际安排| N4
    N4 -->|核对后的课程、名称和版本| N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 -->|新建、复用和生成结果| N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 database;
    class N7 normal;
    class N8 terminal;
