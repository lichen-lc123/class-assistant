%% 管理员课程上传与卡片生成 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["后端｜验证管理员、学期、课程字段<br/>按完整学期展开日期"]
    N2["后端｜计算 courseIdentity<br/>查询当前课程库及模板成员"]
    N3{"后端｜重复规则及预览版本通过？"}
    B3["后端｜返回重复或版本冲突"]
    N4[("数据库｜事务复用或创建 public_courses<br/>保存模板成员及必要的手动快照")]
    N5["后端｜返回 template/manual 来源标识"]
    N6["后端｜后续按来源同步引用<br/>个人覆盖保持优先"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 database;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
