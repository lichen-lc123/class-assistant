%% 管理员课程上传与卡片生成 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜提交管理员导入内容<br/>或手动填写的单门课程"]
    N2["后端｜校验管理员与学期<br/>规范化周次、日期、时间和教室"]
    N3["后端｜检查上课班编号<br/>模板导入去重，手动重复拒绝"]
    N4[("数据库｜保存公共课程及发布状态<br/>导入时同时关联课表模板")]
    N5["后端｜展开课程实际日期与时间<br/>学生仅可读取已发布卡片"]
    N6["前端｜卡片直接展示起止时段<br/>多个时段全部显示，不重复列同一时段"]
    N7["后端｜学生选课前校验时段占用<br/>无冲突才追加到本人课表"]
    N8(["结束"])
    N0 --> N1
    N1 -->|学期及课程原始资料| N2
    N2 -->|规范化课程与班号| N3
    N3 -->|身份有效的课程及发布状态| N4
    N4 -->|已保存卡片与排课配置| N5
    N5 -->|实际起止时间与课次| N6
    N6 -->|选中卡片及本人课表版本| N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 database;
    class N5 normal;
    class N6 normal;
    class N7 normal;
    class N8 terminal;
