%% 管理员模板删除 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜提交模板ID、当前revision<br/>及confirm=true"]
    N2["后端｜校验登录和管理员角色<br/>确认模板存在且版本一致"]
    N3[("数据库｜事务读取模板订阅<br/>同步最新课程成员")]
    N4[("数据库｜模板所选课程转为直接选课<br/>保留课程ID、个人覆盖和作业")]
    N5[("数据库｜解除该模板引用并删除模板<br/>增加受影响个人课表版本")]
    N6["前端｜刷新管理员模板列表<br/>学生不能再次选用被删模板"]
    N7(["结束"])
    N0 --> N1
    N1 -->|管理员会话、模板ID、版本、确认| N2
    N2 -->|有效模板及受影响课表| N3
    N3 -->|最新课程及模板来源关系| N4
    N4 -->|保留的直接选课与个人覆盖| N5
    N5 -->|删除结果与刷新通知| N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 database;
    class N4 database;
    class N5 database;
    class N6 normal;
    class N7 terminal;
