%% 管理员模板删除 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["前端｜提交模板 ID、revision、confirm"]
    N2{"后端｜管理员、版本和确认均有效？"}
    B2["后端｜拒绝无权限或旧版本请求"]
    N3[("数据库｜事务保留受影响用户的课程<br/>必要时转换为直接卡片来源")]
    N4[("数据库｜删除模板和来源订阅关联<br/>保留公共课程及作业")]
    N5["前端｜刷新管理和可选模板清单"]
    N6(["结束"])
    N0 --> N1
    N1 --> N2
    N2 -->|否| B2
    N2 -->|是| N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 decision;
    class B2 exception;
    class N3 database;
    class N4 database;
    class N5 normal;
    class N6 terminal;
