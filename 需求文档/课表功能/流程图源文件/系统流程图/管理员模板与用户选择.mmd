%% 管理员模板与用户选择 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜管理员选择AI内容或Excel<br/>按学期逐份预览并命名确认"]
    N2[("数据库｜保存模板与去重卡片引用<br/>不复制重复上课班")]
    N3["前端｜弹框读取本学期已发布模板<br/>左右切换时自动预览全部课程"]
    N4["后端｜校验登录、学期、模板发布<br/>及已有时段与本批时段无冲突"]
    N5["后端｜返回全部课程及版本摘要<br/>前端仅展示课程，不显示核对清单"]
    N6["后端与数据库｜校验当前预览版本<br/>点击使用后保存模板同步关系"]
    N7["前端｜显示本人课表<br/>模板增删成员自动同步，保留个人调整"]
    N8(["结束"])
    N0 --> N1
    N1 -->|管理员提供的公共资料| N2
    N2 --> N3
    N3 -->|已发布的学期模板| N4
    N4 --> N5
    N5 --> N6
    N6 -->|模板课程和上课班信息| N7
    N7 -->|学生确认的模板成员| N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 database;
    class N3 normal;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 normal;
    class N8 terminal;
