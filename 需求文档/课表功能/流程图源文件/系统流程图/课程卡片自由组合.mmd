%% 课程卡片自由组合 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["后端｜返回已发布卡片及库版本"]
    N2["前端｜维护本次选中卡片集合"]
    N3["后端｜合并已有课表和新增安排<br/>展开本学期实际日期"]
    N4{"后端｜课程身份、版本及时间无冲突？"}
    B4["后端｜拒绝并返回冲突详情"]
    N5["前端｜展示月度预览并确认"]
    N6["后端｜保存前重跑相同检查"]
    N7[("数据库｜事务新增选课引用<br/>不覆盖用户原课表")]
    N8(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 normal;
    class N6 normal;
    class N7 database;
    class N8 terminal;
