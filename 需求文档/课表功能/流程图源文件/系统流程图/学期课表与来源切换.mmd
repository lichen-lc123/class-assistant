%% 学期课表与来源切换 · 系统流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["后端｜从会话确定用户和目标学期"]
    N2[("数据库｜按 user_id 与 term_id<br/>读取唯一个人课表及订阅")]
    N3["后端｜预览展开新增与已有课次"]
    N4{"后端｜本人范围、版本及冲突检查通过？"}
    B4["后端｜拒绝越权或整批冲突"]
    N5[("数据库｜事务保存新增课程和来源引用")]
    N6["后端｜返回公共基值与个人覆盖合成结果"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 database;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 database;
    class N6 normal;
    class N7 terminal;
