%% 学期课表与来源切换 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜读取用户当前学期课表<br/>提交本次来源、内容及版本"]
    N2["后端｜校验会话及目标学期<br/>解析AI、模板或卡片"]
    N3[("数据库｜读取本人各学期安排<br/>公共基值、个人覆盖和模板订阅")]
    N4["后端｜展开新课次并检查实际时段<br/>包括本批内部、跨午夜及跨学期"]
    N5{"后端｜没有重复时段<br/>且课表版本有效？"}
    B5["返回课程时间重复或旧版本错误<br/>整批不保存，确认不能绕过"]
    N6[("数据库｜事务追加课程及来源归属<br/>模板建立订阅，保留原有个人调整")]
    N7["后端｜返回最新本人课表<br/>模板或卡片以后仍同步更新"]
    N8(["结束"])
    N0 --> N1
    N1 -->|新增来源、内容和版本| N2
    N2 -->|已验证的本人账号与学期| N3
    N3 -->|本人最终时间安排及新课程| N4
    N4 -->|占用检查结果和当前版本| N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 -->|已保存课表与同步关系| N7
    N7 --> N8
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 database;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 database;
    class N7 normal;
    class N8 terminal;
