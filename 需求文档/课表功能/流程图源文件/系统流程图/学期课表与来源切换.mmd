%% 学期课表与来源切换 · 系统流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["前端｜读取管理员已配置的学期<br/>后端按日期定位，从会话识别用户"]
    N2[("数据库｜读取当前学期<br/>查询本人课表与 source")]
    N3{"后端｜存在当前课表？"}
    B3["允许进入四选一创建流程"]
    N4["前端｜请求切换时展示删除确认"]
    N5{"前端｜用户确认删除？"}
    B5["不发送删除请求<br/>保留原表"]
    N6["后端｜校验登录和个人课表归属"]
    N7[("数据库｜事务删除该学期个人选课<br/>个人安排与覆盖，解除来源限制")]
    N8["前端｜开放四个建立入口<br/>不同时创建多份学期课表"]
    N9[("数据库｜按用户、学年、学期<br/>校验唯一性并保存来源与课程关系")]
    N10(["结束"])
    N0 --> N1
    N1 -->|用户身份与学期| N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 --> N7
    N7 --> N8
    N8 -->|新来源及确认后的选课数据| N9
    N9 --> N10
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 database;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 normal;
    class N7 database;
    class N8 normal;
    class N9 database;
    class N10 terminal;
