%% 管理员校历导入与核对 · 业务流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员｜进入建立或编辑学期<br/>复制校历提取提示词"]
    N2["管理员｜将图片与提示词<br/>交给自行选择的外部 AI"]
    N3["外部 AI｜提取学期、教学周、作息<br/>上课日、考试、假期和备注"]
    N4["管理员｜粘贴完整结果或选择文件<br/>系统自动解析，无需另点导入"]
    N5{"网站｜格式和日期有效？"}
    B5["提示具体问题<br/>原有学期不变"]
    N6["网站｜一次填入所有字段和分类<br/>直接显示学期摘要与校历核对表"]
    N7["管理员｜核对完整校历<br/>手动修改字段为可选收起入口"]
    N8{"管理员｜点击确认无误<br/>并保存？"}
    B8["保持草稿或取消<br/>不改数据库"]
    N9["网站｜保存学期和完整校历<br/>学生直接使用当前学期导入课表"]
    N10(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 --> N7
    N7 --> N8
    N8 -->|否| B8
    N8 -->|是| N9
    N9 --> N10
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 normal;
    class N7 normal;
    class N8 decision;
    class B8 exception;
    class N9 normal;
    class N10 terminal;
