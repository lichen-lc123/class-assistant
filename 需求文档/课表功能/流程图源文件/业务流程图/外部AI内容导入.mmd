%% 外部AI内容导入 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["用户｜复制 AI 整理提示词"]
    N2["用户｜在外部 AI 提交学校课程文字"]
    N3["用户｜粘贴全部内容或分段追加<br/>查看字符数及结尾，可放大编辑"]
    N4["网站｜按完整学期规则生成课程安排<br/>默认已核对，用户仍可调整"]
    N5{"网站｜没有时间冲突且字段有效？"}
    B5["用户｜按提示修正时间或缺失信息"]
    N6["用户｜确认追加课程<br/>管理员则保存命名模板及公共卡片"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 normal;
    class N7 terminal;
