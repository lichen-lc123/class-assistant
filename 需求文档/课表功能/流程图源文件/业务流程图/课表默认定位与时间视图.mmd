%% 课表默认定位与时间视图 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["用户｜进入我的课程"]
    N2["网站｜默认展示课程卡片<br/>点击卡片打开课程详情"]
    N3["用户｜切换课表 Tab"]
    N4["网站｜电脑默认月视图<br/>手机默认整周视图"]
    N5["用户｜切换日期或允许的视图<br/>需要时进入课表管理"]
    N6(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 normal;
    class N5 normal;
    class N6 terminal;
