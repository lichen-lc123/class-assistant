%% Excel课表导入 · 业务流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["学生｜直接上传本人 Excel 课表<br/>自动沿用管理员设置的当前学期"]
    N2["学生｜上传属于所选学期的<br/>一个或多个课表文件"]
    N3{"系统｜来源限制和文件检查通过？"}
    B3["提示先删除旧来源<br/>或修正文件"]
    N4["系统｜展示该学期课程清单<br/>保留各文件的原始学季与来源"]
    N5["学生｜确认疑似重复和上课班<br/>补充周次或明确日期"]
    N6["系统｜结合日历与作息<br/>预览课表、冲突和待安排课程"]
    N7{"学生｜确认保存？"}
    B7["取消，不替换原课表"]
    N8["系统｜保存一份学期个人课表"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    N7 -->|否| B7
    N7 -->|是| N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 normal;
    class N6 normal;
    class N7 decision;
    class B7 exception;
    class N8 normal;
    class N9 terminal;
