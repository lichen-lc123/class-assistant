%% 课程卡片自由组合 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["用户｜搜索课程或老师"]
    N2["用户｜点击卡片或拖到待添加区域"]
    N3["用户｜检查并预览本学期月度安排"]
    N4{"网站｜新增课程与已有课表均不冲突？"}
    B4["用户｜按提示移除冲突卡片"]
    N5["用户｜确认添加课程"]
    N6["网站｜保留已有课表并新增引用<br/>后续按卡片来源同步"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
