%% 学期课表与来源切换 · 业务流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员｜统一设置学年、学期<br/>起止日期与教学作息"]
    N2["学生｜进入课表管理直接导入<br/>系统读取当前学期与现有来源"]
    N3{"学生｜要更换建立来源？"}
    B3["继续查看或校对当前课表"]
    N4["学生｜请求删除该学期个人课表"]
    N5{"学生｜确认删除原课表？"}
    B5["取消，保留原课表与来源"]
    N6["系统｜清除该学期个人课表<br/>保留公共数据与其他学期"]
    N7["学生｜重新四选一<br/>外部 AI / Excel / 模板 / 卡片"]
    N8["学生｜预览、确认后生成学期课表"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 -->|否| B3
    N3 -->|是| N4
    N4 --> N5
    N5 -->|否| B5
    N5 -->|是| N6
    N6 --> N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 decision;
    class B3 exception;
    class N4 normal;
    class N5 decision;
    class B5 exception;
    class N6 normal;
    class N7 normal;
    class N8 normal;
    class N9 terminal;
