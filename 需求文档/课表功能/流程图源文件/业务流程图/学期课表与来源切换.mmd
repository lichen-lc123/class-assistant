%% 学期课表与来源切换 · 业务流程图 · V1.0 · 2026-11-02
flowchart TD
    N0(["开始"])
    N1["管理员｜维护学期与公共课程<br/>学生只使用已配置学期"]
    N2["学生｜选择AI、模板或卡片<br/>已有课表也可继续新增"]
    N3["网站｜生成本次课程预览<br/>按个人最终安排检查占用"]
    N4{"网站｜新增课程时段<br/>均未重复？"}
    B4["提示重复课程、日期和具体时段<br/>本次整批不保存"]
    N5["学生｜查看课程并点击添加<br/>模板不显示额外核对清单"]
    N6["网站｜追加本次课程及来源关系<br/>原有课程和个人调整保留"]
    N7["管理员｜以后更新模板或卡片<br/>同步其来源课程，额外追加保留"]
    N8["学生｜可继续任意方式添加<br/>也可移除课程或清空本学期"]
    N9(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    N8 --> N9
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 normal;
    class N6 normal;
    class N7 normal;
    class N8 normal;
    class N9 terminal;
