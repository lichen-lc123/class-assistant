%% 学期课表与来源切换 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["用户｜进入我的课程并读取当前学期"]
    N2["用户｜到课表管理选择 AI、模板或卡片"]
    N3["网站｜与已有全部学期及本次课程检查时间"]
    N4{"网站｜没有时间冲突且版本有效？"}
    B4["网站｜提示重叠课程和日期<br/>保留原课表"]
    N5["网站｜追加到本人同一学期课表"]
    N6["用户｜可调整个人安排<br/>或确认清空本学期后重新导入"]
    N7(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 -->|否| B4
    N4 -->|是| N5
    N5 --> N6
    N6 --> N7
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 decision;
    class B4 exception;
    class N5 normal;
    class N6 normal;
    class N7 terminal;
