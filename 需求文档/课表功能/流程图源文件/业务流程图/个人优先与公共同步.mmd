%% 个人优先与公共同步 · 业务流程图 · 当前版 · 2026-11-09
flowchart TD
    N0(["开始"])
    N1["管理员｜维护公共模板或课程卡片"]
    N2["网站｜按来源更新公共基值和引用"]
    N3["用户｜可调整自己的时间或地点"]
    N4["网站｜未修改字段跟随公共安排<br/>个人修改过的安排保持优先"]
    N5["用户｜公共课次改变后核对个人覆盖"]
    N6(["结束"])
    N0 --> N1
    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    classDef normal fill:#FFFFFF,stroke:#A8B2A2,color:#344235;
    classDef decision fill:#F0ECE2,stroke:#A69B83,color:#344235;
    classDef terminal fill:#E5ECE2,stroke:#8A9D82,color:#344235;
    classDef exception fill:#F2EAE6,stroke:#B09B91,color:#344235;
    classDef database fill:#E7EDF0,stroke:#8A9CA6,color:#344235;
    class N0 terminal;
    class N1 normal;
    class N2 normal;
    class N3 normal;
    class N4 normal;
    class N5 normal;
    class N6 terminal;
